    "@tanstack/ai-mcp": "^1.0.0",
    "@tanstack/ai-openai": "^1.0.0",
    "@valibot/to-json-schema": "^1.8.0",
    "eventsource-parser": "^4.1.3",
    "hono": "4.13.11",
    "uuid": "14.0.2",
    "valibot": "^1.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "typescript": "^5.9.3"
  }
}
