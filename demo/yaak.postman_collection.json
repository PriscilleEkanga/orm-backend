    {
      "name": "10. TanStack AI chat via MCP: SSE",
      "item": [
        {
          "name": "POST /chat: stream my reservations",
          "request": {
            "method": "POST",
            "url": "http://127.0.0.1:3000/chat",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "01900000-0000-7000-8000-000000000001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Show my reservations using your tools\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
