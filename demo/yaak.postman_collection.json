              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 7,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"reserve_event\",\n    \"arguments\": {\n      \"eventId\": \"01900000-0000-7000-8000-000000000004\",\n      \"quantity\": 2\n    }\n  }\n}",
              "options": {
                "raw": {
