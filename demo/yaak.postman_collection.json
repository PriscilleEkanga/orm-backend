    {
      "name": "7. Cancel: replace reservationId first",
      "item": [
        {
          "name": "REST: POST /reservations/:reservationId/cancellation",
          "request": {
            "method": "POST",
            "url": "http://127.0.0.1:3000/reservations/{{reservationId}}/cancellation",
            "header": [
              {
                "key": "X-User-Id",
                "value": "01900000-0000-7000-8000-000000000001"
              }
            ]
          }
        },
        {
          "name": "MCP: cancel_reservation",
          "request": {
            "method": "POST",
            "url": "http://127.0.0.1:3000/mcp",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              },
              {
                "key": "MCP-Protocol-Version",
                "value": "2025-11-25"
              },
              {
                "key": "X-User-Id",
                "value": "01900000-0000-7000-8000-000000000001"
